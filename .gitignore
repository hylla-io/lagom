# macOS
.DS_Store

# Rust build outputs
/target/
crates/*/target/
coverage.out

# graphify knowledge-graph artifacts (machine-generated, do not commit)
graphify-out/

# lagom-py (maturin) build + test artifacts
crates/lagom-py/dist/
crates/lagom-py/.venv/
__pycache__/
.pytest_cache/

# lagom-node (napi-rs) build + test artifacts. The compiled `.node` addon is a
# per-platform binary (re)built by `just node-build`; node_modules is the napi
# CLI cache. The generated `index.js`/`index.d.ts` ARE committed — they are the
# npm package's public surface (mirrors the committed go/.wasm blob).
crates/lagom-node/*.node
crates/lagom-node/node_modules/
crates/lagom-node/npm/

# lagom-via-sand e2e: machine-specific generated files (resolved profiles carry
# absolute paths; scratch verify dirs). Templates + scripts + transcripts ARE
# committed; these are regenerated by `just reproduce`.
e2e/runs/_resolved/
e2e/runs/_verify-leak/

# Agent / tool state — track project-level config (.claude/agents/*.md +
# .claude/settings.json + .claude/hooks/) so subagent personas + tool
# allowlists travel with the repo. Per-machine variants stay ignored.
.claude/*.local.json
.claude/sessions/
.claude/agent-runs/
.claude/hooks/ta_gate_debug.log
.claude/hooks/agent_audit_errors.log

# ta runtime state — track only the schema + bundled agents/config; runtime
# DBs, logs, and cascade scratch stay ignored.
.ta/*
!.ta/schema.toml

# Cross-binding parity guard (`just parity`): per-face result maps + the runner
# crates' build dirs are machine-generated. The fixture + runners + comparator
# ARE committed (they are the guard's source); only the run outputs are ignored.
parity/out/
parity/runners/*/target/

# Editor / IDE cruft
.vscode/
.idea/
*.swp
*.swo

# Secrets
.env
.env.local
*.pem
*.key
